{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "svelte",
      "vite/client",
      "node"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "customConditions": [
      "browser"
    ]
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.svelte",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vite.local.config.ts",
    "vitest.config.ts"
  ]
}
