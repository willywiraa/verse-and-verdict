{
  "name": "fit-the-crime",
  "private": true,
  "version": "0.1.0",
  "description": "A small browser game: pick the punishment, watch what happens.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "validate": "node scripts/vitest.mjs run tests/content.test.ts --reporter=verbose",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/vitest.mjs run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@lucide/svelte": "^1.72.0"
  }
}
